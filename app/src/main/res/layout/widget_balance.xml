<?xml version="1.0" encoding="utf-8"?>
<!-- Widget: balance del mes y botón para apuntar un gasto. Sin bibliotecas (RemoteViews). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_fondo"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/widget_mes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Balance del mes"
        android:textColor="#FFB3B8C4"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/widget_balance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFeatureSettings="tnum"
        android:text="—"
        android:textColor="#FF4ADE80"
        android:textSize="28sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_detalle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#FFB3B8C4"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_anadir"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/widget_boton"
            android:contentDescription="@string/atajo_gasto"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="+ Gasto"
            android:textColor="#FF16121F"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
